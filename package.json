{
  "name": "@hawiyat/opencode-extension",
  "version": "0.1.0",
  "description": "Hawiyat's OpenCode extension bundle: hawiyat provider, usage stats, bundled subagents, and a readable web fetch tool.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hawiyat-Org/opencode-extension.git"
  },
  "main": "./index.ts",
