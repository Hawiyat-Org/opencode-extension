    "@opencode/plugin": "^2.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.8.2"
  }
